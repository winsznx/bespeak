{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bespeak",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  // nodejs_compat is required by OpenNext's Node shims; global_fetch_strictly_public keeps
  // server-side fetches to our own origin going through the public internet path, which is
  // what the xStocks API and X Layer RPC calls expect.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Receipts are written by the keeper, which does not share a filesystem with this
  // worker. Without shared storage every fill except the ones bundled at build time
  // rendered as "outcome not yet confirmed" in production.
  "kv_namespaces": [
    {
      // Next's incremental cache. Without a store that outlives an isolate, revalidate and
      // the fetch cache do nothing in production and every cold request rebuilds the page.
      "binding": "NEXT_INC_CACHE_KV",
      "id": "5d69228b6d1a40ad9c5199dcd0d9fb7a"
    },
    {
      "binding": "RECEIPTS",
      "id": "484c200eb766414d92ac13644beec33c"
    }
  ],
  "observability": {
    "enabled": true
  }
}
