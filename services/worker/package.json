{
  "name": "@bespeak/worker",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "keeper": "tsx src/run-keeper.ts",
    "verify": "tsx src/cli-verify.ts",
    "registry:push": "tsx src/cli-registry.ts",
    "api": "tsx src/api.ts",
    "keeper:dry": "tsx src/run-keeper.ts --dry-run",
    "routers:push": "tsx src/cli-routers.ts"
  },
  "dependencies": {
    "@bespeak/shared": "workspace:*",
