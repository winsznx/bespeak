{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bespeak-keeper",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // nodejs_compat covers node:crypto, which the OKX request signing uses, and the node:fs
  // import in the shared keeper module, whose write is already best-effort.
  // nodejs_compat covers node:crypto, used to sign OKX requests, and the node:fs import in
  // the shared keeper module, whose write is already best-effort.
  //
  // global_fetch_strictly_public is what lets this worker reach the app's ingest route.
  // Without it a fetch to our own workers.dev hostname is resolved inside Cloudflare rather
  // than over the public internet and comes back 404, so every receipt this keeper produced
  // was built, verified, and then dropped on the doorstep. The same URL answered 200 from
  // anywhere else, which is what made it look like a problem with the route.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Every minute. A standing order should not wait longer than that once its condition
  // holds, and an idle tick is two RPC reads.
  "triggers": {
    "crons": ["* * * * *"]
  },
  // Public configuration. Addresses and RPCs are not secrets; the private key and the OKX
  // credentials are set with `wrangler secret put` and never appear in this file.
  "vars": {
      "XLAYER_RPC_URL": "https://rpc.xlayer.tech",
      "XLAYER_VERIFY_RPC_URL": "https://xlayerrpc.okx.com",
      "KEEPER_LOW_BALANCE_OKB": "0.005",
      "BESPEAK_ASSET_REGISTRY": "0x462A8DF4b4e09E8A2B346E40A14c5b47c1eA1728",
      "BESPEAK_ROUTER_REGISTRY": "0xe8909CE9f80264F253aBE8eA50606a04C4a696c0",
      "BESPEAK_ORDER_MANAGER": "0xE175556a3322A755B14C13403051899b799431d4",
      "BESPEAK_VAULT_FACTORY": "0xC47315E29b4b8AA5aF26c3603f97bb8341d3766B",
      "BESPEAK_EXECUTION_ADAPTER": "0x8fe9dB236df3E7F810D2C2eDE908B3B01C166Ca8",
      "BESPEAK_CONDITION_VERIFIER": "0x0A558281bC3d40f59E31aD18EE0f01A5289dB7b6",
      // v1.1, the generation the web app and the MCP server write to. The keeper ticks
      // both: an order nothing watches is worse than no order at all.
      "BESPEAK_ORDER_MANAGER_V11": "0xF803E6CA20D878e72694f6a9b2fB6D0dDF06BC43",
      "BESPEAK_VAULT_FACTORY_V11": "0xf4a987531b01C88E05442fe8aa228E3E6ed1A3c8",
      "BESPEAK_EXECUTION_ADAPTER_V11": "0xA6DE5fdF38619BBc51d198bE7724795B9Ca29F47",
      "BESPEAK_VERIFY_TIMEOUT_MS": "45000",
      "RECEIPT_INGEST_URL": "https://bespeak.timjosh507.workers.dev/api/receipts"
  },
  // The open spread dataset. The keeper is the only writer: it already holds the OKX
  // credentials and already runs on a schedule, so sampling costs one binding rather than
  // a second service. The web worker binds the same database read-only in practice.
  "d1_databases": [
    {
      "binding": "DATA",
      "database_name": "bespeak-data",
      "database_id": "3bd0342d-4a34-4571-9929-1194ddea37b8"
    }
  ],
  "observability": {
    "enabled": true
  }
}
