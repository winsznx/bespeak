# ---- X Layer ----
XLAYER_RPC_URL=https://rpc.xlayer.tech
# Independent read path used by the verifier. MUST differ from the write RPC.
XLAYER_VERIFY_RPC_URL=https://xlayerrpc.okx.com
XLAYER_CHAIN_ID=196
XLAYER_EXPLORER=https://www.oklink.com/xlayer

# ---- Keeper / operator ----
# Private key of the keeper EOA. Holds OKB for gas only. Never holds user funds.
KEEPER_PRIVATE_KEY=
KEEPER_LOW_BALANCE_OKB=0.05

# ---- OKX DEX API ----
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_PROJECT_ID=

# ---- Deployed contract addresses (filled by deploy script) ----
BESPEAK_VAULT_FACTORY=
BESPEAK_ORDER_MANAGER=
BESPEAK_ASSET_REGISTRY=
BESPEAK_ROUTER_REGISTRY=
BESPEAK_CONDITION_VERIFIER=
BESPEAK_EXECUTION_ADAPTER=

# Builder attribution for the OKX DEX aggregator (optional, off by default).
# Setting both switches on a referrer fee taken out of the user's swap before execution,
# so the deduction must be disclosed in the composer and recorded on the receipt before
# this is enabled in production. Max 3 percent on X Layer.
OKX_BUILDER_FEE_PERCENT=
OKX_BUILDER_FEE_ADDRESS=

RECEIPT_INGEST_URL=
RECEIPT_INGEST_TOKEN=
